# Non-secret settings for the `ai` function. The API key is the AI_API_KEY secret:
#   npx firebase functions:secrets:set AI_API_KEY
# AI_PROVIDER is anthropic, groq or gemini; the models are that provider's model ids.
# For local testing, put the key in functions/.secret.local.
AI_PROVIDER=anthropic
# Generate and first Tutor answers.
AI_MODEL=claude-sonnet-5-5
# Tutor follow-ups after the first answer. Leave empty to use AI_MODEL.
AI_FOLLOWUP_MODEL=claude-haiku-5-5
# Tutor "Extra thinking". Leave empty to use AI_MODEL.
AI_THINKING_MODEL=claude-opus-5-5
AI_DAILY_CREDITS=30
