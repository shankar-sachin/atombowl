# Non-secret settings for the `ai` function. The API key is the AI_API_KEY secret:
#   npx firebase functions:secrets:set AI_API_KEY
# AI_PROVIDER is groq or gemini; AI_MODEL is that provider's model id (Generate and first Tutor answers).
# For local testing, put the key in functions/.secret.local.
AI_PROVIDER=groq
AI_MODEL=openai/gpt-oss-120b
# Tutor follow-ups after the first answer. Leave empty to use AI_MODEL for everything.
AI_FOLLOWUP_MODEL=openai/gpt-oss-20b
AI_DAILY_CREDITS=30
