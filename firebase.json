{
  "hosting": {
    "site": "atombowl",
    "public": "docs",
    "cleanUrls": true,
    "trailingSlash": false,
    "redirects": [
      {"regex": "^/practice_home(?:\\.html)?$", "destination": "/practice-home", "type": 301},
      {"regex": "^/question_bank(?:\\.html)?$", "destination": "/question-bank", "type": 301},
      {"regex": "^/buzzer_rooms(?:\\.html)?$", "destination": "/buzzer-rooms", "type": 301},
      {"regex": "^/buzzer_create(?:\\.html)?$", "destination": "/buzzer-create", "type": 301},
      {"regex": "^/buzzer_room_player(?:\\.html)?$", "destination": "/buzzer-room-player", "type": 301},
      {"regex": "^/buzzer_room(?:\\.html)?$", "destination": "/buzzer-room", "type": 301},
      {"regex": "^/game_clock(?:\\.html)?$", "destination": "/game-clock", "type": 301},
      {"regex": "^/more_options(?:\\.html)?$", "destination": "/game-clock", "type": 301},
      {"regex": "^/microsoft_auth(?:\\.html)?$", "destination": "/microsoft-auth", "type": 301}
    ],
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**", "**/*.map", "**/*.md", "**/.gitkeep"],
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
        ]
      },
      {
        "source": "**/*.@(html|json)",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
      },
      {
        "source": "**/*.@(js|css)",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
      },
      {
        "source": "**/*.@(png|jpg|jpeg|gif|svg|webp|ico|woff|woff2)",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }]
      }
    ]
  },
  "firestore": { "rules": "firestore.rules" },
  "functions": { "source": "functions", "runtime": "nodejs22", "ignore": ["node_modules", ".secret.local"] },
  "emulators": { "firestore": { "port": 8080 }, "auth": { "port": 9099 }, "functions": { "port": 5001 }, "hosting": { "port": 5000 }, "ui": { "enabled": false } }
}
