{
  "name": "atom-bowl",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "node scripts/build.js",
    "build:watch": "node node_modules/typescript/bin/tsc -p tsconfig.json --watch",
    "server": "node server/index.js",
    "start": "npm run server",
    "test": "node --test tests/*.test.js",
    "test:firebase": "firebase emulators:exec --only firestore --project demo-atombowl \"node --test tests/firebase.emulator.js\""
  },
  "dependencies": {
    "express": "^4.22.2"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "firebase": "^12.8.0",
    "firebase-tools": "^15.29.0",
    "typescript": "^5.4.5"
  },
  "overrides": {
    "express": {
      "qs": "^6.16.0",
      "path-to-regexp": "^0.1.13"
    },
    "body-parser": {
      "qs": "^6.16.0"
    }
  },
  "license": "MIT"
}
